{
  "Database": { "Provider": "Postgres" },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Information" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "ServerUrl": "http://seq:5341" } }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Identity": {
    "ConnectionString": "Host=localhost;Port=5432;Database=Flowcast;Username=postgres;Password=postgres",
    "TokenOptions": {
      "Issuer": "https://localhost",
      "Audience": "flowcast-game",
      "AccessTokenExpiryMinutes": 5,
      "RefreshTokenExpiryDays": 1
    },
    "Google": {
      "ClientIds": ["placeholder-for-local.apps.googleusercontent.com"]
    }
  },
  "PlayerProgress": {
    "ConnectionString": "Host=localhost;Port=5432;Database=Flowcast;Username=postgres;Password=postgres"
  },
  "Shop": {
    "ConnectionString": "Host=localhost;Port=5432;Database=Flowcast;Username=postgres;Password=postgres"
  }
}
