{
  "Database": {
    "Provider": "Postgres"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Information" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Identity": {
    "ConnectionString": "Host=localhost;Port=5432;Database=Flowcast;Username=postgres;Password=postgres",
    "TokenOptions": {
      "Issuer": "https://td-dev.kingcodestudio.com",
      "AccessTokenExpiryMinutes": 5,
      "RefreshTokenExpiryDays": 1
    }
  },
  "PlayerProgress": {
    "ConnectionString": "Host=localhost;Port=5432;Database=Flowcast;Username=postgres;Password=postgres"
  },
  "Shop": {
    "ConnectionString": "Host=localhost;Port=5432;Database=Flowcast;Username=postgres;Password=postgres"
  }
}
