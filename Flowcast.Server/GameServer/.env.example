ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

FLOWCAST_IMAGE=registry.yourdomain.com/flowcast:latest

Identity__ConnectionString=Host=db;Port=5432;Database=flowcast_db;Username=flowcast_user;Password=YOUR_DB_PASSWORD
PlayerProgress__ConnectionString=Host=db;Port=5432;Database=flowcast_db;Username=flowcast_user;Password=YOUR_DB_PASSWORD
Shop__ConnectionString=Host=db;Port=5432;Database=flowcast_db;Username=flowcast_user;Password=YOUR_DB_PASSWORD

Identity__TokenOptions__Issuer=https://api.yourdomain.com
Identity__TokenOptions__Audience=flowcast-game
Identity__TokenOptions__AccessTokenExpiryMinutes=15
Identity__TokenOptions__RefreshTokenExpiryDays=30

Database__Provider=Postgres

Serilog__WriteTo__1__Args__ServerUrl=http://seq:5341
